# Chatbot Stack Environment Configuration
# Copy this file to .env and customize as needed

# UI Configuration
CHATBOT_UI_PORT=8085

# Ollama Configuration
# Available models: llama3.2:1b (fast), llama3.2:3b, llama3.2:7b, mistral:7b, neural-chat, etc.
# Full list: https://ollama.ai/library
OLLAMA_HOST_PORT=11435
OLLAMA_MODEL=qwen2.5:3b
DEEPSEEK_MODEL=deepseek-r1:1.5b
CHAT_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_GENERATE_TIMEOUT=420

# API Configuration
CHATBOT_HOST=0.0.0.0
CHATBOT_PORT=8000
CHATBOT_ALLOWED_ORIGINS=http://localhost:8085,http://127.0.0.1:8085
OLLAMA_URL=http://ollama:11434

# Daxview MCP integration
# Direct server: http://192.228.0.161:8001/mcp
# Local Docker Desktop: http://host.docker.internal:8001/mcp
# Shared Docker network: http://daxview-mcp:8001/mcp
# Production: https://mcp.example.com/mcp behind HTTPS and access control
DAXVIEW_MCP_ENABLED=false
DAXVIEW_MCP_URL=http://192.228.0.161:8001/mcp
DAXVIEW_MCP_AUTH_TOKEN=
DAXVIEW_MCP_TIMEOUT=20
DAXVIEW_MCP_PROTOCOL_VERSION=2025-06-18

# Tracing (for debugging)
CHATBOT_TRACE_LIMIT=200
AI_DEBUG_DASHBOARD_ENABLED=false
AI_DEBUG_DASHBOARD_KEY=
AI_REFINE_MCP_WITH_MODEL=true
AI_COMPARE_MODEL_ENABLED=false
AI_COMPARE_MODEL=deepseek-r1:1.5b
# Optional comma-separated comparison models; Qwen3 8B is the stronger model option.
AI_COMPARE_MODELS=deepseek-r1:1.5b,qwen3:8b
AI_COMPARE_MODEL_SHOW_TO_USER=true
AI_CHARTS_ENABLED=false
